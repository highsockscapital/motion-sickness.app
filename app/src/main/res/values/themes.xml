<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Light Theme enforcing custom palette — uses system Material parent to avoid missing com.google.android.material dependency -->
    <style name="Theme.MotionOverlay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorBackground">@color/window_background</item>
    </style>
</resources>
